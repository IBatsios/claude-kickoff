# Generated from docs/intake.md by kickoff v{{version}}. Edit the intake, not this file.
# Builder: lines starting with "# Builder:" are instructions; remove them. This file is written to the project root as .env.example.
# Every variable the project needs, with a placeholder value and one comment saying where the real value comes from.
# Copy to .env and fill in. .env is ignored by git.

# Builder: only when stack.database is not none. Value from the runbook's database step.
DATABASE_URL="postgresql://user:password@localhost:5432/{{slug}}"

# Builder: only for the ts-prisma-postgres set or when a server is implied.
PORT=3000

# Builder: only when features.auth is true. AUTH_SECRET is any long random string the user generates.
AUTH_SECRET="changeme"
# Builder: one pair per OAuth provider in features.auth_methods, e.g. Google, GitHub, Apple, Microsoft. Value from the provider's developer console.
{{PROVIDER}}_CLIENT_ID="changeme"
{{PROVIDER}}_CLIENT_SECRET="changeme"
# Builder: for single sign-on, the issuer URL and client credentials from the identity provider.

# Builder: one block per integration in 7.1. Name them <SERVICE>_API_KEY, or the name the service documents. Comment with where to get it.
# {{service}}: from {{where}}
{{SERVICE}}_API_KEY="changeme"
